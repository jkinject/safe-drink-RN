{
  "expo": {
    "name": "Safedrink",
    "slug": "safe-drink-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon.png",
    "scheme": "safedrinkrn",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.safedrink.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.safedrink.app",
      "adaptiveIcon": {
        "backgroundColor": "#6B63E8",
        "foregroundImage": "./assets/images/app_icon.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEEDF8",
          "image": "./assets/images/app_icon.png",
          "imageWidth": 140
        }
      ],
      "expo-sqlite",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#6C63E0"
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000,
      "url": "https://u.expo.dev/d4523f48-fc64-42d2-a324-64a6e6b6cee0"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4523f48-fc64-42d2-a324-64a6e6b6cee0"
      }
    },
    "owner": "jkinject",
    "platforms": [
      "ios",
      "android"
    ]
  }
}