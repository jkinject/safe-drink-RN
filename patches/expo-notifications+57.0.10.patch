diff --git a/node_modules/expo-notifications/android/build/intermediates/packaged_res/release/packageReleaseResources/layout/safedrink_timer_big.xml b/node_modules/expo-notifications/android/build/intermediates/packaged_res/release/packageReleaseResources/layout/safedrink_timer_big.xml
new file mode 100644
index 0000000..f0dfdc8
--- /dev/null
+++ b/node_modules/expo-notifications/android/build/intermediates/packaged_res/release/packageReleaseResources/layout/safedrink_timer_big.xml
@@ -0,0 +1,38 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  safedrink patch: 알림 펼친 상태의 큰 카운트다운.
+
+  Chronometer 는 RemoteViews 가 지원하는 위젯이라, setChronometerCountDown 을
+  걸어두면 앱 프로세스 없이 시스템이 직접 1초씩 깎는다.
+  접힌 상태 높이는 시스템이 고정하므로 큰 표시는 이 확장 뷰에서만 가능하다.
+-->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:orientation="vertical"
+    android:paddingStart="16dp"
+    android:paddingEnd="16dp"
+    android:paddingTop="4dp"
+    android:paddingBottom="12dp">
+
+    <TextView
+        android:id="@+id/safedrink_timer_title"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:textSize="13sp"
+        android:textColor="?android:attr/textColorSecondary"
+        android:maxLines="1"
+        android:ellipsize="end" />
+
+    <Chronometer
+        android:id="@+id/safedrink_timer_chronometer"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="2dp"
+        android:textSize="44sp"
+        android:textStyle="bold"
+        android:textColor="?android:attr/textColorPrimary"
+        android:includeFontPadding="false"
+        android:fontFamily="sans-serif-medium" />
+
+</LinearLayout>
diff --git a/node_modules/expo-notifications/android/build/intermediates/packaged_res/release/packageReleaseResources/layout/safedrink_timer_small.xml b/node_modules/expo-notifications/android/build/intermediates/packaged_res/release/packageReleaseResources/layout/safedrink_timer_small.xml
