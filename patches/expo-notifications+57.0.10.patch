@@ -0,0 +1,46 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  safedrink patch: 알림 카운트다운 레이아웃.
+  Chronometer 는 RemoteViews 지원 위젯이라 setChronometerCountDown 을 걸면
+  앱 프로세스 없이 시스템이 직접 1초씩 깎는다.
+  색은 반드시 명시할 것 — RemoteViews 는 시스템 알림 텍스트 색을 상속하지 않는다.
+-->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:orientation="vertical"
+    android:paddingStart="16dp"
+    android:paddingEnd="16dp"
+    android:paddingBottom="4dp">
+
+    <TextView
+        android:id="@+id/safedrink_timer_title"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:textSize="13sp"
+        android:textColor="?android:attr/textColorSecondary"
+        android:maxLines="1"
+        android:ellipsize="end" />
+
+    <Chronometer
+        android:id="@+id/safedrink_timer_chronometer"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="1dp"
+        android:textSize="44sp"
+        android:textStyle="bold"
+        android:textColor="@color/safedrink_timer_accent"
+        android:includeFontPadding="false"
+        android:fontFamily="sans-serif-medium" />
+
+    <TextView
+        android:id="@+id/safedrink_timer_subtitle"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="1dp"
+        android:textSize="12sp"
+        android:textColor="?android:attr/textColorSecondary"
+        android:maxLines="1"
+        android:ellipsize="end" />
+
+</LinearLayout>
