# 이 파일을 .env.local 로 복사해 값을 채운다 (.env*.local 은 gitignore).
# 둘 중 하나라도 비어 있으면 Google 백업 기능 전체가 꺼진다(src/config/backup.ts BACKUP_SUPPORTED).
# EXPO_PUBLIC_* 값을 바꾼 뒤 로컬 릴리스 APK 를 다시 빌드할 때는
# android/app/build/generated/assets 와 generated/res 를 지울 것(CLAUDE.md).

# 백업 Worker 주소 — 예: https://safedrink-backup.<계정>.workers.dev (끝 슬래시 없이)
EXPO_PUBLIC_BACKUP_API_URL=

# Google Cloud "웹 애플리케이션" OAuth 클라이언트 ID (Android 클라이언트 ID 아님)
# 예: 1234567890-abc.apps.googleusercontent.com — Worker 의 GOOGLE_CLIENT_ID 와 같은 값
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
